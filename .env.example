DISCORD_TOKEN=your-bot-token-here
# Optional: your server ID, so slash commands show up instantly instead of after up to an hour
DEV_GUILD_ID=
# Role allowed to control music (server admins always can). If the role does not exist, everyone can.
DJ_ROLE=DJ
# Volume (0-100) the bot starts at each time it joins a voice channel.
DEFAULT_VOLUME=30
# Optional: Spotify app credentials (the app's owner needs Spotify Premium). Spotify links work
# without them; see "Spotify links" in the README for when they help.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
